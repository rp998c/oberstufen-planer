# All settings are optional. Without any of them the app works out of the box
# (password is chosen in the browser on first start).
#
# AUTH=none                 # no login, e.g. behind your own auth proxy
# APP_PASSWORD_HASH='...'   # fixed password hash instead of the in-app password
# ORIGIN=https://abi.example.org
# TZ=Europe/Berlin
# PUID=1000                 # owner of the data directory
# PGID=1000
